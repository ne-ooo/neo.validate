{
  "name": "@lpm.dev/neo.validate",
  "version": "1.1.0",
  "description": "Zero-dependency string validation and sanitization - Tree-shakeable alternative to validator.js",
  "author": "neo",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    ".lpm",
    "README.md",
    "SECURITY.md",
    "BENCHMARKS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "node scripts/verify-package.mjs",
    "test:watch": "vitest",
    "bench": "vitest bench --run --no-file-parallelism --maxWorkers=1",
    "typecheck": "tsc --noEmit",
    "release:check": "lpm run typecheck && lpm run test:coverage && lpm run build && lpm run test:package && lpm audit --level moderate --fail-on vuln",
    "prepublishOnly": "lpm run release:check"
  },
  "keywords": [
    "lpm",
    "validator",
    "validation",
    "sanitization",
    "string",
    "email",
    "url",
    "validator.js",
    "tree-shakeable",
    "zero-dependency",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ne-ooo/neo.validate"
  },
  "bugs": {
    "url": "https://github.com/ne-ooo/neo.validate/issues"
  },
  "homepage": "https://github.com/ne-ooo/neo.validate#readme",
  "devDependencies": {
    "@types/node": "^20.19.33",
    "@types/validator": "^13.15.10",
    "@vitest/coverage-v8": "^3.2.7",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "validator": "^13.12.0",
    "vitest": "^3.2.7",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
